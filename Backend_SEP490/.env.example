# ----------------------
# Database
# ----------------------
DB_PASSWORD=changeme
ConnectionStrings__DefaultConnection=Host=<db-host>;Port=5432;Database=<db-name>;Username=<db-user>;Password=<db-password>

# ----------------------
# JWT
# ----------------------
JWT_KEY=replace-with-strong-secret
JWT_ISSUER=https://your-domain.com
JWT_AUDIENCE=https://your-domain.com
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------
# Email (SMTP)
# ----------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=example@gmail.com
EMAIL_PASSWORD=app-specific-password

# ----------------------
# Cloudinary
# ----------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# ----------------------
# OpenAI
# ----------------------
OPENAI_API_KEY=sk-xxxx

# ----------------------
# GHN Sandbox/Production
# ----------------------
GHN_TEST_TOKEN=token
GHN_TEST_SHOP_ID=0
GHN_TEST_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_TEST_FROM_NAME=Warehouse name
GHN_TEST_FROM_PHONE=0123456789
GHN_TEST_FROM_ADDRESS=123 Test Street
GHN_TEST_FROM_DISTRICT_ID=0
GHN_TEST_FROM_WARD_CODE=00000
GHN_TEST_TO_DISTRICT_ID=0
GHN_TEST_TO_WARD_CODE=00000
GHN_TEST_FALLBACK_PHONE=0123456789
GHN_TEST_PAYMENT_TYPE_ID=2
GHN_TEST_SERVICE_TYPE_ID=2
GHN_TEST_REQUIRED_NOTE=KHONGCHOXEMHANG
GHN_TEST_DEFAULT_ITEM_WEIGHT=500
GHN_TEST_DEFAULT_PARCEL_LENGTH=20
GHN_TEST_DEFAULT_PARCEL_WIDTH=20
GHN_TEST_DEFAULT_PARCEL_HEIGHT=10

# ----------------------
# VNPAY Sandbox/Production
# ----------------------
VNPAY_TMN_CODE=XXXX
VNPAY_HASH_SECRET=XXXX
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://your-domain.com/api/payment/vnpay/callback
VNPAY_DEFAULT_BANK_CODE=NCB
VNPAY_VERSION=2.1.0
VNPAY_LOCALE=vn
VNPAY_CURRENCY_CODE=VND
VNPAY_COMMAND=pay
VNPAY_EXPIRE_MINUTES=15
